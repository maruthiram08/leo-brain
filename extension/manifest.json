{
    "manifest_version": 3,
    "name": "Leo - Ambient Memory",
    "version": "2.1",
    "description": "Capture and recall from your second brain.",
    "permissions": [
        "activeTab",
        "scripting",
        "clipboardRead"
    ],
    "host_permissions": [
        "http://localhost:3000/*",
        "https://leo-brain.vercel.app/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "commands": {
        "save_capture": {
            "suggested_key": {
                "default": "Ctrl+Shift+E",
                "mac": "Command+Shift+E"
            },
            "description": "Save to Leo"
        },
        "trigger_recall": {
            "suggested_key": {
                "default": "Ctrl+Shift+Y",
                "mac": "Command+Shift+Y"
            },
            "description": "Recall from Leo"
        }
    },
    "action": {
        "default_title": "Leo - Click to Recall",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    }
}