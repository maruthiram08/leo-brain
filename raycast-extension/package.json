{
    "$schema": "https://www.raycast.com/schemas/extension.json",
    "name": "leo-recall",
    "title": "Leo Recall",
    "description": "Recall from your second brain",
    "icon": "command-icon.png",
    "author": "maruthi",
    "categories": [
        "Productivity"
    ],
    "license": "MIT",
    "commands": [
        {
            "name": "recall",
            "title": "Recall from Leo",
            "description": "Surface relevant past events from your memory",
            "mode": "view"
        }
    ],
    "preferences": [
        {
            "name": "apiUrl",
            "title": "API URL",
            "description": "Leo API endpoint",
            "type": "textfield",
            "required": false,
            "default": "https://leo-brain.vercel.app"
        },
        {
            "name": "authToken",
            "title": "Auth Token",
            "description": "Extension authentication token",
            "type": "password",
            "required": true
        }
    ],
    "dependencies": {
        "@raycast/api": "^1.64.0"
    },
    "devDependencies": {
        "@raycast/eslint-config": "^1.0.8",
        "@types/node": "20.8.10",
        "@types/react": "^18.2.0",
        "eslint": "^8.51.0",
        "prettier": "^3.0.3",
        "typescript": "^5.2.2"
    },
    "scripts": {
        "build": "ray build -e dist",
        "dev": "ray develop",
        "fix-lint": "ray lint --fix",
        "lint": "ray lint"
    }
}