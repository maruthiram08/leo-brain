## 4. Minimal Node.js Implementation (Works Today)

### Install deps

```bash
npm install node-fetch cheerio
```

### Metadata fetcher (simple + safe)

```js
import fetch from "node-fetch";
import cheerio from "cheerio";
import { URL } from "url";

export async function enrichUrl(url) {
  try {
    const res = await fetch(url, {
      timeout: 3000,
      redirect: "follow",
      headers: {
        "User-Agent": "Mozilla/5.0"
      }
    });

    const html = await res.text();
    const $ = cheerio.load(html);

    const title =
      $('meta[property="og:title"]').attr("content") ||
      $("title").text() ||
      null;

    const description =
      $('meta[property="og:description"]').attr("content") ||
      $('meta[name="description"]').attr("content") ||
      null;

    const parsedUrl = new URL(url);

    return {
      enriched_title: title?.trim(),
      enriched_description: description?.trim()?.slice(0, 240),
      source_domain: parsedUrl.hostname,
      favicon_url: `${parsedUrl.origin}/favicon.ico`,
      enrichment_status: "success"
    };
  } catch (err) {
    return { enrichment_status: "failed" };
  }
}
```

This is **enough** for v1.

